# Alinea — déploiement TEST Cloud Run (copier en .env.test)
GCP_PROJECT_ID=suren-saas
GCP_REGION=europe-west1
SERVICE_NAME=alinea-test

# Public (build-time, inliné dans le bundle — publishable, inutilisable seule)
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REDACTED

# Secrets (→ Secret Manager par deploy.sh)
SUPABASE_SERVICE_KEY=REDACTED
GEMINI_API_KEY=
R2_S3_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
R2_BUCKET=suren-saas-ged
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
