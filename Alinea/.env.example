# HermesWeb — variables d'environnement (COPIER en .env.local, JAMAIS versionné)
# Public (bundle navigateur) — anon key publishable, inutilisable seule (RLS deny-all)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Serveur uniquement — JAMAIS préfixé NEXT_PUBLIC_
# service key (D8-v3 : la webapp opère en service key, scoping en code)
SUPABASE_SERVICE_KEY=

# Recherche sémantique (miroir pipeline : gemini-embedding-001, 768d)
GEMINI_API_KEY=

# GED R2 — URLs signées serveur (TTL 15 min)
R2_S3_ENDPOINT=https://<account>.eu.r2.cloudflarestorage.com
R2_BUCKET=suren-saas-ged
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Déploiement (Cloud Run, injecté par deploy.sh)
BUILD_ID=
ENVIRONMENT=
