# Local-only environment values — copy to .env.local (gitignored) or export in ~/.bashrc
# Placeholder references in docs ([VPS_IP], etc.) map to these variables.

# VPS identity
VPS_IP=your.vps.ip.here
VPS_HOSTNAME=your-hostname
VPS_SSH_PORT=22
VPS_SSH_KEY=~/.ssh/id_xxx
VPS_SSH_ALIAS=vps

# Syncthing (device ID of the VPS)
SYNCTHING_DEVICE_ID=XXXXXXX-XXXXXXX-...

# Tailscale
TAILSCALE_IP=100.x.y.z
