    "objet": {"type": ["string", "null"]},
    "date_facture": {"type": ["string", "null"], "description": "ISO 8601 si possible, sinon texte brut"},
    "date_echeance": {"type": ["string", "null"]},
    "montant_ht": {"type": ["number", "null"]},
    "montant_tva": {"type": ["number", "null"]},
    "montant_ttc": {"type": ["number", "null"]},
    "devise": {"type": ["string", "null"], "description": "EUR par défaut"},
    "lignes": {
      "type": ["array", "null"],
      "items": {
        "type": "object",
        "properties": {
          "designation": {"type": ["string", "null"]},
