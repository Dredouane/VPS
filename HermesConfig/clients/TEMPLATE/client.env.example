# HermesConfig — client TEMPLATE
# Copier ce fichier vers clients/<slug>/client.env et renseigner les valeurs.
# ⚠️ Ce fichier contient des secrets: chmod 600, JAMAIS commité (gitignore *.env).

# --- Identité (non secret) ---------------------------------------------------
CLIENT_SLUG=TEMPLATE
CLIENT_NAME="Nom du client PME"

# --- Telegram ----------------------------------------------------------------
# Nouveau bot @BotFather dédié (option A — zéro conflit 409 avec un bot existant)
TELEGRAM_BOT_TOKEN=
# User IDs Telegram autorisés (séparés par des virgules) — liste blanche stricte
TELEGRAM_ALLOWED_USERS=

# --- Modèle / fournisseur LLM ------------------------------------------------
HERMES_MODEL_PROVIDER=deepseek
HERMES_MODEL=deepseek-chat
# Clé API du fournisseur (deepseek par défaut)
DEEPSEEK_API_KEY=

# --- Optionnel ---------------------------------------------------------------
# Port explicite (sinon auto-alloc à partir de 8654)
# HERMES_PORT=8654
# Tag d'image pinnée (sinon HERMES_IMAGE_TAG ou défaut du spawn script)
# HERMES_IMAGE_TAG=v2026.5.16-522
